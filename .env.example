# Neon Postgres (PostGIS) — used ONLY by ingest scripts, never by public pages
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require
DATABASE_URL_POOLED=postgresql://user:pass@host/db?sslmode=require&pgbouncer=true

# Cloudflare R2 — stores facilities-{hash}.json.gz and PMTiles
R2_ACCOUNT_ID=your-cloudflare-account-id
R2_ACCESS_KEY_ID=your-r2-access-key-id
R2_SECRET_ACCESS_KEY=your-r2-secret-access-key
R2_BUCKET_NAME=usdatacenterwatch

# R2 public dev URL — exposed to the browser bundle (PUBLIC_ prefix = Astro env var).
# Get this from: CF dashboard → R2 → bucket → Settings → Public access dev URL
# Form: https://pub-<hash>.r2.dev
# Set as a GitHub Actions repository VARIABLE (not secret — it's not credentials).
PUBLIC_R2_BASE_URL=https://pub-<hash>.r2.dev

# Linear — issue tracking / agent status updates
LINEAR_API_KEY=lin_api_...

# Cloudflare deployment
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id

# Neon project management (for branch/project ops and db:migrate verification)
NEON_API_KEY=your-neon-api-key
NEON_PROJECT_ID=your-neon-project-id
NEON_BRANCH_ID=your-neon-main-branch-id
