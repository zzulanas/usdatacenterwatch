---
import Layout from '@/components/Layout.astro';
---

<Layout title="About — US Data Center Watch">
  <div class="max-w-3xl mx-auto px-4 py-12">
    <h1 class="text-2xl font-semibold text-neutral-100">About</h1>
    <p class="mt-4 text-neutral-400 text-sm">
      US Data Center Watch is an open-source, civic-transparency tool mapping US data centers with
      modeled community-impact data: power, water, land, public subsidies, and jobs.
    </p>
  </div>
</Layout>
