---
import Layout from '@/components/Layout.astro';
import MapView from '@/components/MapView';
import { Button } from '@/components/ui/button';
---

<Layout title="US Data Center Watch — Map">
  <div class="flex flex-col h-[calc(100vh-3.5rem)]">
    <!-- Filter bar stub -->
    <div class="border-b border-neutral-800 px-4 py-2 flex items-center gap-3">
      <Button variant="outline" size="sm">
        Filters
      </Button>
      <span class="text-xs text-neutral-500 font-mono">
        5 seed facilities — live data pipeline coming in USD-11
      </span>
    </div>

    <!-- Map area — full-bleed, client:only to keep maplibre off SSR -->
    <div class="flex-1">
      <MapView client:only="react" />
    </div>
  </div>
</Layout>
